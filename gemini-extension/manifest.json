{
  "manifest_version": 3,
  "name": "Gemini Api Agent",
  "version": "2.2.1",
  "description": "Auto-syncs Google Gemini cookies to your own local Free Gemini API server over a token-authenticated bridge",
  "permissions": ["cookies", "storage", "alarms", "clipboardWrite"],
  "host_permissions": [
    "*://*.google.com/*",
    "*://*.google.co/*",
    "*://*.googleusercontent.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "http://[::1]/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Gemini Api Agent"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
